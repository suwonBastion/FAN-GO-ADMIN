[Unit]
Description=adminProject FastAPI (gunicorn/uvicorn)
After=network.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/home/ec2-user/adminProject
Environment=PYTHONUNBUFFERED=1
# .env 는 app/core/config.py 가 WorkingDirectory 기준으로 읽는다.
ExecStart=/home/ec2-user/adminProject/.venv/bin/gunicorn -c deploy/gunicorn_conf.py app.main:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
